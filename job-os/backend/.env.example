# SQLite is the local default. Switch later by pointing this at PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/job_os
DATABASE_URL=sqlite:///./job_os.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:43180,http://localhost:43180

# Requirement extraction. Leave AI_PROVIDER=none to disable extraction.
# openai and openai_compatible use an OpenAI-style Chat Completions API.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
